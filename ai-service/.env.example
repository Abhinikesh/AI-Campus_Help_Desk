# CampusSphere AI Service — Environment Configuration Template
# Copy this file to .env and fill in real values before running.
# NEVER commit the .env file to Git.

# ── Service ──────────────────────────────────────────────────────────────────
PORT=5002
FLASK_ENV=development          # development | production
SERVICE_NAME=campussphere-ai-service
VERSION=2.0.0

# ── Inter-service Authentication ──────────────────────────────────────────────
# Shared secret used in the X-Internal-Key header between Node.js and this service.
# Must match INTERNAL_API_KEY in server/.env
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_API_KEY=REPLACE_WITH_STRONG_RANDOM_SECRET

# ── Biometric Encryption ──────────────────────────────────────────────────────
# AES-256 key material for encrypting face embedding templates at rest.
# Must match BIOMETRIC_SECRET_KEY in server/.env
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
BIOMETRIC_SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_SECRET

# ── Flask Session Secret ───────────────────────────────────────────────────────
SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_SECRET

# ── Face Matching Thresholds (Euclidean distance on 128-d unit sphere) ─────────
# dlib ResNet validated operating thresholds:
#   EER ≈ 0.58 on LFW benchmark (FRR ≈ FAR at threshold 0.55-0.58)
#   MATCH_THRESHOLD:  <= this  → VERIFIED
#   REVIEW_THRESHOLD: <= this  → VERIFICATION_REQUIRES_REVIEW (faculty review needed)
#   Above REVIEW_THRESHOLD    → NOT_MATCHED
# These are configurable but should NOT be overridden by frontend requests.
MATCH_THRESHOLD=0.55
REVIEW_THRESHOLD=0.65

