# ── Server ─────────────────────────────────────────────────────
PORT=5001
NODE_ENV=development

# ── MongoDB ─────────────────────────────────────────────────────
# Leave blank in development to use an auto-started persistent in-memory server.
# In production you MUST set this to a real MongoDB Atlas URI:
#   mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=

# ── JWT ────────────────────────────────────────────────────────
# Generate a strong secret (min 32 chars). Run: npm run setup
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ── Client ─────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ── AI (optional) ──────────────────────────────────────────────
# Get a free key at https://console.groq.com
GROQ_API_KEY=
