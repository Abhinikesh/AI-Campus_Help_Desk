node_modules/
.venv/
*/.venv/
__pycache__/
*.pyc

# ── Environment (never commit secrets) ────────────────────────
.env
.env.local
.env.production
.env.development
.env.test
# .env.example is intentionally NOT ignored — commit it

# ── Build outputs ─────────────────────────────────────────────
dist/
dist-ssr/
build/

# ── Uploads (user files) ──────────────────────────────────────
server/uploads/*
!server/uploads/.gitkeep
server/uploads/drive/*
!server/uploads/drive/.gitkeep

# ── Dev DB (mongodb-memory-server persistent data) ────────────
server/.data/

# ── OS / Editor junk ──────────────────────────────────────────
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vscode/*
!.vscode/extensions.json
.idea/

# ── Logs ──────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Misc ──────────────────────────────────────────────────────
*.local
